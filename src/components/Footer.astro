---

<section
  class="h-full w-full relative overflow-hidden flex flex-col items-center justify-center py-[40px] px-4 bg-bg-off-white"
>
  <!-- Title -->
  <div class="mb-20 md:mb-32 animate-slide-in-fall text-center">
    <h2
      class="font-bonny font-normal text-[40px] md:text-[60px] text-accent-dark leading-tight"
    >
      {t["footer.title"]}
    </h2>
  </div>

  <!-- Icons Container -->
  <div
    class="grid grid-cols-2 md:grid-cols-5 justify-center gap-8 md:gap-16 w-full max-w-[1200px]"
  >
    {
      socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.name !== "email" ? "_blank" : undefined}
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-4 group last:col-span-2 md:last:col-span-1"
        >
          <div class="w-[80px] h-[80px] md:w-[100px] md:h-[100px] bg-black rounded-full flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox={link.viewBox}
              class="w-10 h-10 md:w-12 md:h-12 fill-white"
            >
              <path d={link.iconPath} />
            </svg>
          </div>
          <div class="flex flex-col items-center text-accent-dark font-pilcrow font-medium text-[18px] md:text-[24px]">
            <span class="text-center">
              {t[`footer.${link.name}` as keyof typeof t]}
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
