---
import SkillsSection from "./SkillsSection"
import { getLangFromUrl, useTranslations } from '../utils/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const textLanSkills = t('skills.list')

---

<section class="mx-0 md:mx-20 my-10 w-auto h-[50rem] p-15 text-4xl">
    <div class="flex justify-center items-center">
         <h2 class="bg-[#85282b] inline-block mb-5 py-2 px-5 text-white text-6xl font-['Crimson-Pro']"> {t('skills.title')}</h2>
    </div>
    <div class="flex gap-10 h-[30rem]">
    <SkillsSection
    tLanguage={textLanSkills}
    client:load/>
  </div>
</section>