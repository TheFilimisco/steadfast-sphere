---
import { getLangFromUrl, useTranslations } from "../utils/i18n/utils";
import AnimatedTitle from "./react/AnimatedTitle";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  class="relative w-full h-[60rem] sm:h-[50rem] md:h-[55rem] lg:h-[60rem] overflow-hidden group"
>
  <img
    id="zoom-img"
    src="/bg-header.jpg"
    alt="bg-header"
    class="w-full h-full object-cover
    transform scale-100
    transition-transform
    duration-[20000ms]
    ease-in-out
    absolute
    group-hover:scale-150
    z-0"
  />

  <div class="absolute top-4 right-4 z-2">
    <div class="relative flex gap-3 p-2 bg-transparent">
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/">EN</a
      >
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/es">ES</a
      >
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/ca">CA</a
      >
    </div>
  </div>

  <AnimatedTitle
    article={t("header.title.article")}
    span={t("header.title.span")}
    subtitle={t("header.subtitle")}
    text={t("header.text")}
    textSpan={t("header.text.span")}
    client:load
  />
</header>
