---
import { getLangFromUrl, useTranslations } from "../utils/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  class="relative w-full h-[60rem] sm:h-[50rem] md:h-[55rem] lg:h-[60rem] overflow-hidden group"
>
  <img
    id="zoom-img"
    src="/bg-header.jpg"
    alt="bg-header"
    class="w-full h-full object-cover
    transform scale-100
    transition-transform
    duration-[10000ms]
    ease-in-out
    absolute
    group-hover:scale-110
    z-0"
  />

  <div class="absolute top-4 right-4 z-2">
    <div class="relative flex gap-3 p-2 bg-transparent">
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/">EN</a
      >
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/es">ES</a
      >
      <a
        class="text-white font-['Gloock'] text-3xl hover:cursor-pointer transition-colors duration-200 hover:bg-black"
        href="/ca">CA</a
      >
    </div>
  </div>

  <div
    class="relative z-1 flex flex-col items-start justify-center h-full px-6 sm:px-12 md:px-24 lg:pl-96 space-y-6 cursor-default"
  >
    <h1
      class="font-['Gloock'] text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl tracking-normal text-black leading-tight w-full max-w-[60rem]"
    >
      {t("header.title.article")}

      <span
        class="bg-[#9B696A] text-[#F2F2F2] transition-colors hover:bg-[#F2F2F2] hover:text-[#9B696A] ease-in-out duration-700"
        >{t("header.title.span")}</span
      >

      {t("header.subtitle")}
    </h1>

    <h2
      class="ml-1 sm:ml-2 font-['Gloock'] font-light text-2xl sm:text-3xl md:text-4xl flex flex-wrap items-center"
    >
      {t("header.text")}
      <span
        class="text-[#691e21] p-1 sm:p-2 bg-[#F5F6F1] font-bold text-3xl sm:text-4xl ml-2 transition-colors hover:bg-[#691e21] hover:text-[#F5F6F1] ease-in-out duration-700"
        >{t("header.text.span")}</span
      >
    </h2>
  </div>
</header>
