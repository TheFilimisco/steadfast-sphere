---
import Filigram from "./filigram/Filigram.astro";
import { getLangFromUrl, useTranslations } from "../utils/i18n/utils";
import AnimatedAbout from "./react/AnimatedAboutMe";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section>
  <Filigram />
  <AnimatedAbout
    aboutTitle={t("about.title")}
    aboutSubtitle={t("about.subtitle")}
    aboutTexto={t("about.texto")}
    aboutButton={t("about.button")}
    profileImgSrc="/profile.jpeg"
    cvDownloadPath={`/cv/${t("skills.list")}.pdf`}
    cvFilename="thefilimisco-CV.pdf"
    client:load
  />
  <Filigram />
</section>
