---
import { getCollection } from "astro:content";
import { ui, defaultLang } from "../utils/i18n/ui";

import githubIcon from "../assets/icons/github.svg?raw";
import webIcon from "../assets/icons/web.svg?raw";

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;
const t = ui[lang] || ui[defaultLang as keyof typeof ui];

const projects = await getCollection("projects");
// Sort by ID to ensure order
const sortedProjects = projects.sort((a, b) => a.data.id - b.data.id);
---

<section
  class="h-screen w-full relative overflow-hidden bg-black flex flex-col items-center justify-center py-[40px] px-4 md:px-[120px]"
>
  <!-- Header -->
  <div class="w-full max-w-[1440px] mb-10 animate-slide-in-fall z-10 flex justify-center">
    <h2
      class="font-bonny font-medium text-[30px] md:text-[40px] text-bg-off-white text-left"
    >
      {t["projects.title"]}
    </h2>
  </div>

  <!-- Carousel Container -->
  <div class="relative w-full max-w-[1440px] h-[70vh] md:h-[600px] flex items-center justify-around">
    
    <!-- Projects List -->
    <div class="relative w-full h-full">
      {
        sortedProjects.map((project, index) => (
          <div
            class={`project-slide absolute inset-0 w-full h-full transition-opacity duration-500 ease-in-out grid grid-cols-1 md:grid-cols-8 gap-8 items-center ${
              index === 0 ? "opacity-100 z-10 pointer-events-auto" : "opacity-0 z-0 pointer-events-none"
            }`}
            data-index={index}
          >
           <!-- Left Column: Title -->
           <div class="col-span-1 md:col-span-2 h-full flex items-center md:items-start justify-center md:justify-center flex-col ml-5 animate-slide-in-left">
              <h3 class="font-pilcrow text-4xl md:text-4xl text-bg-off-white leading-tight break-words w-full text-center">
                {project.data.title}
              </h3>
           </div>

            <!-- Center Column: Image -->
            <div class="col-span-1 md:col-span-4 h-full flex flex-col gap-6 justify-center">
                 <!-- Image -->
                 <div class="w-full h-[200px] md:h-[450px] rounded-[20px] overflow-hidden shadow-lg relative group">
                    <img
                      src={`/${project.data.img}`}
                      alt={project.data.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
                 </div>
            </div>

            <div class="col-span-1 md:col-span-2 h-full flex flex-col gap-6 justify-center animate-slide-in-right">
                  <!-- Description & Stack -->
                 <div class="flex flex-col gap-4">
                    <p class="font-manrope text-sm md:text-base text-gray-300 leading-relaxed max-w-2xl">
                        {project.data.description[lang] || project.data.description[defaultLang]}
                    </p>


                    <div class="flex flex-wrap gap-2">
                        <span class="px-3 py-1 rounded-full border border-gray-600 text-gray-300 text-xs font-medium">
                            {project.data.frontend}
                        </span>
                        {project.data.backend && (
                            <span class="px-3 py-1 rounded-full border border-gray-600 text-gray-300 text-xs font-medium">
                            {project.data.backend}
                        </span>
                        )}
                        {project.data.database && (
                            <span class="px-3 py-1 rounded-full border border-gray-600 text-gray-300 text-xs font-medium">
                            {project.data.database}
                        </span>
                        )}
                    </div>
                </div>

                <!-- Buttons -->
                 <div class="flex flex-col gap-4 mt-2 items-center md:items-start">
                     {project.data.web && (
                        
                        <a href={project.data.web} target="_blank" rel="noopener noreferrer" class="px-8 py-3 bg-white text-black rounded-full font-medium hover:bg-gray-200 transition-colors duration-300 text-sm flex items-center">
                            Visit Site
                         <div class="ml-2 text-[20px] [&>svg]:w-full [&>svg]:h-full" set:html={webIcon} />
                        </a>
                     )}
                     {project.data.repository_frontend && (
                         <a href={project.data.repository_frontend} target="_blank" rel="noopener noreferrer" class="px-8 py-3 border border-white text-white rounded-full font-medium hover:bg-white hover:text-black transition-colors duration-300 text-sm flex items-center justify-between">
                             {project.data.repository_backend ? "Frontend" : "GitHub"}
                             <div class="ml-2 text-[20px] [&>svg]:w-full [&>svg]:h-full" set:html={githubIcon} />
                         </a>
                     )}
                     {project.data.repository_backend && (
                         <a href={project.data.repository_backend} target="_blank" rel="noopener noreferrer" class="px-8 py-3 border border-white text-white rounded-full font-medium hover:bg-white hover:text-black transition-colors duration-300 text-sm flex items-center justify-between">
                             {project.data.repository_frontend ? "Backend" : "GitHub"}
                             <div class="ml-2 text-[20px] [&>svg]:w-full [&>svg]:h-full" set:html={githubIcon} />
                         </a>
                     )}
                 </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Navigation Buttons -->
    <button
      id="prev-btn"
      class="absolute bg-black/50 left-0 md:bottom-auto md:-left-12 md:top-1/2 md:-translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full border border-white/20 text-white hover:bg-white hover:text-black hover:cursor-pointer transition-all duration-300 z-20"
      aria-label="Previous project"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    
    <button
      id="next-btn"
      class="absolute right-0 bg-black/50 md:bottom-auto md:-right-12 md:top-1/2 md:-translate-y-1/2 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-full border border-white/20 text-white hover:bg-white hover:text-black hover:cursor-pointer transition-all duration-300 z-20"
      aria-label="Next project"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>

  </div>
</section>


