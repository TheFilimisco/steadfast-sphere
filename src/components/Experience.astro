---
import { Image } from "astro:assets";
import { ui, defaultLang } from "../utils/i18n/ui";
import softwareengineering from "../assets/experience/softwarengineering.svg";
import persuadis from "../assets/experience/persuadis.svg";

const lang = (Astro.currentLocale || defaultLang) as keyof typeof ui;
const t = ui[lang] || ui[defaultLang as keyof typeof ui];
---

<section
    class="h-full w-full relative overflow-hidden bg-bg-off-white flex flex-col items-center justify-center py-[40px] px-4 md:px-[120px]"
>
    <!-- Header -->
    <div
        class="w-full max-w-[1440px] mb-16 animate-slide-in-fall z-10 flex justify-center"
    >
        <h2
            class="font-bonny font-medium text-[30px] md:text-[40px] text-accent-dark text-center"
        >
            {t["experience.title"]}
        </h2>
    </div>

    <!-- Timeline Container -->
    <div class="w-full max-w-5xl flex flex-col gap-10 md:gap-8 relative">
        <!-- Item 1: Software Engineering (Left Text, Right Logo) -->
        <div
            class="flex flex-col md:flex-row items-center justify-start gap-8 md:gap-16 w-full animate-slide-in-left"
        >
            <!-- Text Content -->
            <div
                class="flex-1 flex flex-col items-center md:items-start text-center md:text-left order-2 md:order-1"
            >
                <h3 class="text-2xl md:text-3xl text-black font-bold mb-1">
                    {t["experience.job1.title"]}
                </h3>
                <div class="flex items-center gap-2 mb-4">
                    <span class="font-bold text-accent-dark text-lg"
                        >{t["experience.job1.company"]}</span
                    >
                    <span class="w-1 h-1 bg-gray-400 rounded-full"></span>
                    <span class="text-gray-500 text-sm font-manrope"
                        >{t["experience.job1.date"]}</span
                    >
                </div>
                <div
                    class="hidden md:block font-pilcrow text-black max-w-md leading-relaxed"
                    set:html={t["experience.job1.desc"]}
                />
            </div>

            <!-- Logo/Visual -->
            <div
                class="flex-1 flex justify-center md:justify-end order-1 md:order-2"
            >
                <div
                    class="w-32 h-32 md:w-40 md:h-40 rounded-full border border-gray-200 flex items-center justify-center shadow-sm"
                >
                    <Image
                        src={softwareengineering}
                        alt="Software Engineering Logo"
                        class="w-full h-full object-contain"
                    />
                </div>
            </div>
        </div>

        <div class="w-full h-[1px] bg-accent-dark"></div>

        <!-- Item 2: FullStack Developer (Right Text, Left Logo) -->
        <div
            class="flex flex-col items-center md:flex-row justify-end gap-8 md:gap-16 w-full animate-slide-in-right"
        >
            <!-- Text Content -->
            <div
                class="flex-1 flex flex-col items-center md:items-start text-center md:text-left order-2 md:order-1"
            >
                <h3
                    class="font-pilcrow text-2xl md:text-3xl text-black font-bold mb-1"
                >
                    {t["experience.job2.title"]}
                </h3>
                <div class="flex items-center gap-2 mb-4">
                    <span class="font-bold text-accent-dark text-lg"
                        >{t["experience.job2.company"]}</span
                    >
                    <span class="w-1 h-1 bg-gray-400 rounded-full"></span>
                    <span class="text-gray-500 text-sm font-manrope"
                        >{t["experience.job2.date"]}</span
                    >
                </div>
                <div
                    class="hidden md:block font-pilcrow text-black max-w-md leading-relaxed"
                    set:html={t["experience.job2.desc"]}
                />
            </div>

            <!-- Logo/Visual -->
            <div
                class="flex-1 flex justify-center md:justify-end order-1 md:order-2"
            >
                <div
                    class="w-32 h-32 md:w-40 md:h-40 rounded-full border border-gray-200 bg-black flex items-center justify-center shadow-sm"
                >
                    <Image
                        src={persuadis}
                        alt="Persuadis Logo"
                        class="w-full h-full object-contain"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
