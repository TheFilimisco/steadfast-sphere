---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import AboutMe from "../../components/AboutMe.astro";
import Skills from "../../components/Skills.astro";
---

<Layout>
  <!-- Main Container: Relative for absolute positioning of children -->
  <main class="relative h-screen w-full overflow-hidden bg-bg-off-white">
    <!-- Hero Section (Z-20: Top) -->
    <div
      id="section-0"
      class="section absolute inset-0 z-20 transition-opacity duration-1000 ease-in-out opacity-100"
      data-index="0"
    >
      <Hero />
    </div>

    <!-- Info Section (Z-10: Behind Hero) -->
    <div
      id="section-1"
      class="section absolute inset-0 z-10 transition-opacity duration-1000 ease-in-out opacity-100"
      data-index="1"
    >
      <AboutMe />
    </div>

    <!-- Skills Section (Z-0: Bottom) -->
    <div
      id="section-2"
      class="section absolute inset-0 z-0 transition-opacity duration-1000 ease-in-out opacity-100"
      data-index="2"
    >
      <Skills />
    </div>

    <!-- Navigation Dots (Z-50: Above everything) -->
    <div
      class="absolute right-[35px] top-1/2 transform -translate-y-1/2 flex flex-col gap-5 bg-black/50 p-2.5 rounded-[30px] hidden md:flex z-50 animate-slide-in-right"
    >
      <button
        class="nav-dot w-3 h-3 rounded-full transition-all duration-300 bg-white cursor-pointer"
        data-target="0"
        aria-label="Go to Hero section"></button>
      <button
        class="nav-dot w-3 h-3 rounded-full transition-all duration-300 bg-[#ddd] opacity-50 cursor-pointer"
        data-target="1"
        aria-label="Go to Info section"></button>
      <button
        class="nav-dot w-3 h-3 rounded-full transition-all duration-300 bg-[#ddd] opacity-50 cursor-pointer"
        data-target="2"
        aria-label="Go to Skills section"></button>
    </div>
  </main>
</Layout>
